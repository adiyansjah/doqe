set(forbidden "libc\\+\\+(abi)?|libstdc\\+\\+|libgcc_s")
if(HOST_SYSTEM STREQUAL "Darwin")
  # otool lists direct load commands. compiler-rt's dylib has its own system
  # libc++ dependencies, while the executable links the pinned C++ archives.
  set(inspect otool -L)
elseif(HOST_SYSTEM STREQUAL "Linux")
  set(inspect ldd)
  string(APPEND forbidden "|libunwind|libasan|libubsan|libclang_rt\\.(asan|ubsan)[^/ \t]*")
else()
  message(FATAL_ERROR "Unsupported platform for runtime dependency check: ${HOST_SYSTEM}")
endif()

foreach(binary IN ITEMS "${DOQE}" "${DOQE_TESTS}")
  execute_process(COMMAND ${inspect} "${binary}"
    OUTPUT_VARIABLE dependencies COMMAND_ERROR_IS_FATAL ANY)
  message(STATUS "Runtime dependencies for ${binary}\n${dependencies}")
  if(dependencies MATCHES "[/\t ](${forbidden})\\." OR dependencies MATCHES "not found")
    message(FATAL_ERROR "Unexpected runtime dependency for ${binary}")
  endif()
  if(NOT SANITIZED AND dependencies MATCHES "libclang_rt\\.(a|ub)san")
    message(FATAL_ERROR "Unexpected shared sanitizer runtime for ${binary}")
  endif()
  if(SANITIZED AND HOST_SYSTEM STREQUAL "Darwin"
      AND NOT dependencies MATCHES "libclang_rt\\.asan_osx_dynamic\\.dylib")
    message(FATAL_ERROR "Missing ASan dylib dependency for ${binary}")
  endif()
  if(SANITIZED AND HOST_SYSTEM STREQUAL "Linux")
    execute_process(COMMAND "${LLVM_NM}" --defined-only "${binary}"
      OUTPUT_VARIABLE symbols COMMAND_ERROR_IS_FATAL ANY)
    if(NOT symbols MATCHES "[ \t]T __asan_init\n")
      message(FATAL_ERROR "Missing statically linked __asan_init in ${binary}")
    endif()
    message(STATUS "Static ASan verified in ${binary}")
  endif()
endforeach()
