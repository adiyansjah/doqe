option(DOQE_ENABLE_SANITIZERS "Instrument the build with AddressSanitizer and UndefinedBehaviorSanitizer" OFF)
if(DOQE_ENABLE_SANITIZERS)
  add_compile_options(-fsanitize=address,undefined -fno-sanitize-recover=all
    -fno-omit-frame-pointer)
  add_link_options(-fsanitize=address,undefined -fno-sanitize-recover=all)
endif()

option(DOQE_ENABLE_FUZZING "Build the libFuzzer harness" OFF)
if(DOQE_ENABLE_FUZZING)
  if(NOT DOQE_ENABLE_SANITIZERS)
    message(FATAL_ERROR "The libFuzzer build requires ASan and UBSan")
  endif()
  add_compile_options(-fsanitize=fuzzer-no-link)
  add_link_options("$<$<STREQUAL:$<TARGET_PROPERTY:NAME>,doqe_json_fuzz>:-fsanitize=fuzzer>")
endif()
