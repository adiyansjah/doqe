# ADR-0002 direct edges. Prefix dependencies with + when a module's public
# headers need their public include roots. Unprefixed edges are private.
set(doqe_module_edges
  "base"
  "column|+base"
  "io|base"
  "format|base|column|io"
  "table|base|column|io|format"
  "catalog|base|io|format|table"
  "exec|base|column|io|format|table"
  "sql|base|column|table|catalog|exec"
  "maintain|base|column|io|table|catalog|exec"
  "engine|base|column|io|format|table|catalog|exec|sql|maintain"
  "api|base|engine"
  "server|base|engine"
  "cli|api")

set(doqe_modules)
foreach(row IN LISTS doqe_module_edges)
  string(REPLACE "|" ";" fields "${row}")
  list(POP_FRONT fields module)
  list(APPEND doqe_modules "${module}")
  set(doqe_direct_${module})
  set(doqe_public_${module})
  set(doqe_link_closure_${module} "doqe_${module}")
  foreach(edge IN LISTS fields)
    string(REGEX REPLACE "^\\+" "" dependency "${edge}")
    list(APPEND doqe_direct_${module} "doqe_${dependency}")
    list(APPEND doqe_link_closure_${module} ${doqe_link_closure_${dependency}})
    if(edge MATCHES "^\\+")
      list(APPEND doqe_public_${module} "doqe_${dependency}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES doqe_link_closure_${module})
endforeach()

function(doqe_add_module module)
  set(target "doqe_${module}")
  add_library(${target} STATIC ${ARGN})
  target_include_directories(${target}
    PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/include"
    PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
  foreach(dependency IN LISTS doqe_direct_${module})
    if(dependency IN_LIST doqe_public_${module})
      target_link_libraries(${target} PUBLIC "${dependency}")
    else()
      target_link_libraries(${target} PRIVATE "${dependency}")
    endif()
  endforeach()
endfunction()

# The pinned runtime and sanitizers supply directory-wide options. Module
# targets must express all other link inputs as plain target dependencies.
function(doqe_check_target_inputs target source_root)
  get_target_property(options "${target}" LINK_OPTIONS)
  if(NOT DEFINED doqe_toolchain_link_options)
    set(doqe_toolchain_link_options "")
  endif()
  if(options STREQUAL "options-NOTFOUND")
    set(options "")
  endif()
  if(NOT options STREQUAL doqe_toolchain_link_options)
    message(FATAL_ERROR "${target}: LINK_OPTIONS may only contain toolchain options")
  endif()
  string(TOUPPER "${CMAKE_BUILD_TYPE}" configuration)
  foreach(property IN ITEMS INTERFACE_LINK_OPTIONS INTERFACE_LINK_LIBRARIES_DIRECT
      INTERFACE_LINK_LIBRARIES_DIRECT_EXCLUDE STATIC_LIBRARY_OPTIONS STATIC_LIBRARY_FLAGS
      "STATIC_LIBRARY_FLAGS_${configuration}" LINK_FLAGS "LINK_FLAGS_${configuration}"
      LINK_DIRECTORIES INTERFACE_LINK_DIRECTORIES INTERFACE_SOURCES)
    get_property(value TARGET "${target}" PROPERTY "${property}")
    if(NOT "${value}" STREQUAL "")
      message(FATAL_ERROR "${target}: ${property} is forbidden ('${value}')")
    endif()
  endforeach()

  file(REAL_PATH "${PROJECT_SOURCE_DIR}/${source_root}" root)
  get_target_property(source_dir "${target}" SOURCE_DIR)
  get_target_property(sources "${target}" SOURCES)
  foreach(source IN LISTS sources)
    if(source MATCHES "\\$<")
      message(FATAL_ERROR "${target}: unsupported source expression '${source}'")
    endif()
    file(REAL_PATH "${source}" source_path BASE_DIRECTORY "${source_dir}")
    cmake_path(IS_PREFIX root "${source_path}" NORMALIZE inside)
    if(NOT inside)
      message(FATAL_ERROR "${target}: source outside ${root}: '${source}'")
    endif()
  endforeach()
endfunction()

function(doqe_check_executables directory)
  get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(target IN LISTS targets)
    get_target_property(type "${target}" TYPE)
    if(type STREQUAL "EXECUTABLE" AND NOT target STREQUAL "doqe"
        AND NOT (BUILD_TESTING AND target MATCHES "^(doqe_tests|doqe_status_tests)$"))
      message(FATAL_ERROR "Unknown executable target: ${target}")
    endif()
  endforeach()
  get_property(subdirectories DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(subdirectory IN LISTS subdirectories)
    doqe_check_executables("${subdirectory}")
  endforeach()
endfunction()

function(doqe_check_test_links target)
  get_property(links TARGET "${target}" PROPERTY LINK_LIBRARIES)
  foreach(link IN LISTS links)
    if(link MATCHES "^GTest::gtest(_main)?$")
      continue()
    endif()
    if(target STREQUAL "doqe_tests" AND TARGET "${link}"
        AND (link STREQUAL "doqe_test_support" OR link STREQUAL "doqe_base_test"))
      continue()
    endif()
    string(REGEX REPLACE "^doqe_" "" module "${link}")
    if(NOT link STREQUAL "doqe_${module}" OR NOT module IN_LIST doqe_modules)
      message(FATAL_ERROR "${target}: non-plain test link '${link}'")
    endif()
  endforeach()
endfunction()

# Read the final properties, including any declarations after module setup.
function(doqe_check_module_links)
  doqe_check_executables("${PROJECT_SOURCE_DIR}")
  doqe_check_target_inputs(doqe src/cli)
  get_target_property(cli_entry_links doqe LINK_LIBRARIES)
  if(NOT cli_entry_links STREQUAL "doqe_cli")
    message(FATAL_ERROR "doqe LINK_LIBRARIES must equal 'doqe_cli', found '${cli_entry_links}'")
  endif()
  if(BUILD_TESTING)
    doqe_check_target_inputs(doqe_tests tests)
    doqe_check_test_links(doqe_tests)
    doqe_check_target_inputs(doqe_status_tests tests/base)
    get_target_property(status_test_links doqe_status_tests LINK_LIBRARIES)
    if(NOT status_test_links STREQUAL "GTest::gtest_main;doqe_base")
      message(FATAL_ERROR "doqe_status_tests must link only GoogleTest and base")
    endif()
  endif()
  if(TARGET doqe_base_test)
    doqe_check_target_inputs(doqe_base_test src/base)
    get_target_property(type doqe_base_test TYPE)
    get_target_property(source_dir doqe_base_test SOURCE_DIR)
    get_target_property(sources doqe_base_test SOURCES)
    get_target_property(links doqe_base_test LINK_LIBRARIES)
    get_target_property(interface doqe_base_test INTERFACE_LINK_LIBRARIES)
    if(NOT BUILD_TESTING OR NOT type STREQUAL "STATIC_LIBRARY"
        OR NOT source_dir STREQUAL PROJECT_SOURCE_DIR OR NOT sources STREQUAL "src/base/memory_pool.cpp"
        OR NOT links STREQUAL "doqe_base" OR NOT interface STREQUAL "$<LINK_ONLY:doqe_base>")
      message(FATAL_ERROR "doqe_base_test: requires just the base pool implementation and a private base link")
    endif()
  endif()
  if(TARGET doqe_test_support)
    get_target_property(type doqe_test_support TYPE)
    if(NOT BUILD_TESTING OR NOT type STREQUAL "STATIC_LIBRARY")
      message(FATAL_ERROR "doqe_test_support: requires BUILD_TESTING and TYPE STATIC_LIBRARY")
    endif()
    doqe_check_target_inputs(doqe_test_support tests/support)
    doqe_check_test_links(doqe_test_support)
    get_property(links TARGET doqe_test_support PROPERTY LINK_LIBRARIES)
    get_property(actual_interface TARGET doqe_test_support PROPERTY INTERFACE_LINK_LIBRARIES)
    set(expected_interface)
    foreach(link IN LISTS links)
      if(link IN_LIST actual_interface)
        list(APPEND expected_interface "${link}")
      else()
        list(APPEND expected_interface "$<LINK_ONLY:${link}>")
      endif()
    endforeach()
    list(SORT expected_interface)
    list(SORT actual_interface)
    if(NOT "${actual_interface}" STREQUAL "${expected_interface}")
      message(FATAL_ERROR "doqe_test_support: INTERFACE_LINK_LIBRARIES must match declared support links")
    endif()
  endif()

  foreach(module IN LISTS doqe_modules)
    set(target "doqe_${module}")
    get_target_property(type "${target}" TYPE)
    if(NOT type STREQUAL "STATIC_LIBRARY")
      message(FATAL_ERROR "${target}: TYPE must be STATIC_LIBRARY, found '${type}'")
    endif()
    get_target_property(public_include "${target}" INTERFACE_INCLUDE_DIRECTORIES)
    set(expected_include "${PROJECT_SOURCE_DIR}/src/${module}/include")
    if(NOT public_include STREQUAL expected_include)
      message(FATAL_ERROR "${target}: INTERFACE_INCLUDE_DIRECTORIES must equal '${expected_include}', found '${public_include}'")
    endif()
    doqe_check_target_inputs("${target}" "src/${module}")
    set(naming_properties OUTPUT_NAME ARCHIVE_OUTPUT_NAME PREFIX SUFFIX)
    foreach(config IN ITEMS "${CMAKE_BUILD_TYPE}" Debug Release RelWithDebInfo MinSizeRel)
      string(TOUPPER "${config}" config)
      list(APPEND naming_properties "OUTPUT_NAME_${config}" "ARCHIVE_OUTPUT_NAME_${config}")
    endforeach()
    foreach(property IN LISTS naming_properties)
      get_property(is_set TARGET "${target}" PROPERTY "${property}" SET)
      if(is_set)
        message(FATAL_ERROR "${target}: ${property} is forbidden")
      endif()
    endforeach()
    get_target_property(actual "${target}" LINK_LIBRARIES)
    if(actual STREQUAL "actual-NOTFOUND")
      set(actual "")
    endif()
    foreach(link IN LISTS actual)
      if(NOT link MATCHES "^doqe_[a-z]+$")
        message(FATAL_ERROR "${target}: non-plain module link '${link}'")
      endif()
      if(NOT TARGET "${link}")
        message(FATAL_ERROR "${target}: unknown module link '${link}'")
      endif()
      get_target_property(alias "${link}" ALIASED_TARGET)
      if(alias)
        message(FATAL_ERROR "${target}: alias module link '${link}'")
      endif()
    endforeach()
    list(SORT actual)
    set(expected "${doqe_direct_${module}}")
    list(SORT expected)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "${target} LINK_LIBRARIES must equal '${expected}', found '${actual}'")
    endif()

    # CMake represents each PRIVATE static-library edge as LINK_ONLY in its
    # interface. Reject extra interface-only links and wrong visibility.
    set(expected_interface "")
    foreach(link IN LISTS doqe_direct_${module})
      if(link IN_LIST doqe_public_${module})
        list(APPEND expected_interface "${link}")
      else()
        list(APPEND expected_interface "$<LINK_ONLY:${link}>")
      endif()
    endforeach()
    get_target_property(actual_interface "${target}" INTERFACE_LINK_LIBRARIES)
    if(actual_interface STREQUAL "actual_interface-NOTFOUND")
      set(actual_interface "")
    endif()
    list(SORT actual_interface)
    list(SORT expected_interface)
    if(NOT actual_interface STREQUAL expected_interface)
      message(FATAL_ERROR "${target} INTERFACE_LINK_LIBRARIES must equal '${expected_interface}', found '${actual_interface}'")
    endif()
  endforeach()
endfunction()
