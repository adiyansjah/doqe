cmake_minimum_required(VERSION 3.25)

file(REAL_PATH "${SOURCE_DIR}" source)
file(REAL_PATH "${BINARY_DIR}" build)
set(generated "${build}/src/cli/build_version.hpp")
set(toolchain_header "${source}/cmake/check-libcxx.hpp")
set(support_root "${source}/tests/support")
set(diagnostic_options
  "-W[a-zA-Z0-9_-]+|-W(no-)?error=[a-zA-Z0-9_-]+|-f(no-)?color-diagnostics|-fdiagnostics-color(=(auto|always|never))?")
if(GOOGLETEST_SOURCE_DIR)
  file(REAL_PATH "${GOOGLETEST_SOURCE_DIR}" googletest)
endif()

file(STRINGS "${build}/module-edges.txt" edge_rows)
foreach(row IN LISTS edge_rows)
  string(REPLACE "|" ";" fields "${row}")
  list(POP_FRONT fields module)
  list(APPEND modules "${module}")
  set(root_${module} "${source}/src/${module}")
  set(public_root_${module} "${root_${module}}/include/doqe/${module}")
  foreach(edge IN LISTS fields)
    string(REGEX REPLACE "^[+]" "" dependency "${edge}")
    list(APPEND direct_${module} "${dependency}")
    list(APPEND include_closure_${module} "${dependency}" ${public_closure_${dependency}})
    if(edge MATCHES "^[+]")
      list(APPEND public_${module} "${dependency}")
      list(APPEND public_closure_${module} "${dependency}" ${public_closure_${dependency}})
    endif()
  endforeach()
  foreach(closure IN ITEMS include public)
    list(REMOVE_DUPLICATES ${closure}_closure_${module})
  endforeach()
endforeach()
foreach(module IN LISTS TEST_LINKS TEST_SUPPORT_PUBLIC_LINKS)
  list(APPEND test_closure "${module}" ${public_closure_${module}})
endforeach()
foreach(module IN LISTS SUPPORT_LINKS)
  list(APPEND support_closure "${module}" ${public_closure_${module}})
endforeach()

function(reject path reason)
  string(REPLACE "${source}/" "" display "${path}")
  string(REPLACE "${build}/" "" display "${display}")
  message(FATAL_ERROR "\n  Module include boundaries: ${display}: ${reason}\n")
endfunction()

function(ninja_tool output)
  execute_process(COMMAND "${NINJA}" -t ${ARGN}
    WORKING_DIRECTORY "${build}" OUTPUT_VARIABLE result COMMAND_ERROR_IS_FATAL ANY)
  set("${output}" "${result}" PARENT_SCOPE)
endfunction()

# Ninja's current compile edges identify which dep records must exist.
ninja_tool(compdb compdb -x)
string(JSON count LENGTH "${compdb}")
if(count EQUAL 0)
  message(FATAL_ERROR "Module include boundaries: no Ninja compile edges")
endif()
math(EXPR last "${count} - 1")

function(check_final_link target)
  file(STRINGS "${build}/CMakeFiles/${target}-link-inputs.txt" allowed)
  list(POP_FRONT allowed executable)
  file(REAL_PATH "${executable}" executable)
  file(RELATIVE_PATH executable "${build}" "${executable}")
  set(archives)
  foreach(archive IN LISTS allowed)
    file(REAL_PATH "${archive}" archive)
    list(APPEND archives "${archive}")
  endforeach()
  set(allowed "${archives}")
  # Older CMake versions may repeat a declared transitive archive when it is
  # also linked directly. Only accept repeats represented in Ninja's link edge.
  ninja_tool(link_edge query "${executable}")
  string(REGEX MATCHALL "\n    [|] [^\n]+[.]a" archive_edges "${link_edge}")
  set(declared_archives)
  foreach(edge IN LISTS archive_edges)
    string(SUBSTRING "${edge}" 7 -1 archive)
    file(REAL_PATH "${archive}" archive BASE_DIRECTORY "${build}")
    if(archive IN_LIST archives)
      if(archive IN_LIST declared_archives)
        list(APPEND allowed "${archive}")
      endif()
      list(APPEND declared_archives "${archive}")
    endif()
  endforeach()
  list(APPEND allowed ${objects_${target}})
  set(link_command "")
  # compdb -x expands Ninja's generated response file, when present.
  foreach(index RANGE 0 "${last}")
    string(JSON output GET "${compdb}" "${index}" output)
    if(output STREQUAL executable)
      string(JSON link_command GET "${compdb}" "${index}" command)
      break()
    endif()
  endforeach()
  separate_arguments(arguments UNIX_COMMAND "${link_command}")
  list(POP_FRONT arguments prefix separator compiler)
  if(NOT prefix STREQUAL ":" OR NOT separator STREQUAL "&&" OR NOT compiler STREQUAL CLANG)
    message(FATAL_ERROR "${target} link command has an unexpected driver invocation")
  endif()
  set(link_options
    "-g|-O[0-3sz]|-DNDEBUG|-nostdlib[+][+]|--rtlib=compiler-rt|--unwindlib=none"
    "-mmacosx-version-min=[0-9.]+|-fsanitize=address,undefined|-fno-sanitize-recover=all"
    "${diagnostic_options}"
    "-Wl,(--start-group|--end-group|-search_paths_first|-headerpad_max_install_names)")
  list(JOIN link_options "|" link_options)
  set(pending "")
  foreach(argument IN LISTS arguments)
    if(argument STREQUAL "&&")
      break() # CMake's post-link step is a separate shell command.
    elseif(pending STREQUAL "-o" AND argument STREQUAL executable)
      set(pending "")
    elseif(pending STREQUAL "-arch" AND argument STREQUAL "arm64")
      set(pending "")
    elseif(pending STREQUAL "-isysroot" AND IS_DIRECTORY "${argument}")
      set(pending "")
    elseif(pending STREQUAL "-Xlinker" AND argument STREQUAL "-no_exported_symbols")
      set(pending "")
    elseif(pending)
      message(FATAL_ERROR "${target} link command uses unexpected ${pending} argument: ${argument}")
    elseif(argument MATCHES "^(-o|-arch|-isysroot|-Xlinker)$")
      set(pending "${argument}")
    elseif(argument MATCHES "^(${link_options})$")
      continue()
    elseif(NOT argument MATCHES "^[-@]" AND argument MATCHES "[.](a|o)$")
      file(REAL_PATH "${argument}" input BASE_DIRECTORY "${build}")
      list(FIND allowed "${input}" input_index)
      if(input_index LESS 0)
        if(input IN_LIST seen_inputs)
          message(FATAL_ERROR "${target} link command repeats input: ${argument}")
        endif()
        if(argument MATCHES "[.]o$")
          message(FATAL_ERROR "${target} link command uses foreign object: ${argument}")
        endif()
        message(FATAL_ERROR "${target} link command uses archive outside the allowed closure: ${argument}")
      endif()
      list(REMOVE_AT allowed "${input_index}")
      list(APPEND seen_inputs "${input}")
    else()
      message(FATAL_ERROR "${target} link command uses unsupported argument: ${argument}")
    endif()
  endforeach()
  if(pending OR allowed)
    message(FATAL_ERROR "${target} link command is missing expected arguments: ${pending}${allowed}")
  endif()
endfunction()

# Use Clang's own search list so joined flags, aliases, quote-only paths,
# frameworks, sysroots and implicit paths use the compiler's interpretation.
function(compiler_search_paths command directory input output_quote output_angle output_framework)
  separate_arguments(arguments UNIX_COMMAND "${command}")
  list(POP_FRONT arguments compiler)
  if(NOT compiler STREQUAL CLANG AND NOT compiler STREQUAL C_COMPILER)
    reject("${input}" "unexpected compiler: ${compiler}")
  endif()
  # CMake 3.25 may use the draft spellings for the same language modes.
  set(compile_options
    "-[IDUF][^-].*|--(include-directory|sysroot)=.+|-std=(c[+][+](23|2b)|c(11|17|23|2x))"
    "-stdlib=libc[+][+]|-nostdinc[+][+]|-g|-O[0-3sz]|-fPIC|-fPIE|-fno-omit-frame-pointer"
    "-fno-sanitize-recover=all|-fsanitize=address,undefined|-mmacosx-version-min=[0-9.]+"
    "${diagnostic_options}")
  list(JOIN compile_options "|" compile_options)
  set(options)
  set(pending "")
  foreach(argument IN LISTS arguments)
    if(pending)
      if(argument MATCHES "^[-@]")
        reject("${input}" "unsupported compiler argument: ${argument}")
      endif()
      if(NOT pending MATCHES "^(-o|-MF|-MT|-MQ|-MJ|-include|-imacros)$")
        list(APPEND options "${pending}" "${argument}")
      endif()
      set(pending "")
    elseif(argument MATCHES "^(-o|-MF|-MT|-MQ|-MJ|-include|-imacros)$")
      set(pending "${argument}")
    elseif(argument MATCHES "^(-c|-MD|-MMD|-MP|-MG)$" OR argument STREQUAL input)
      continue()
    elseif(argument MATCHES "^(-I|-D|-U|-F|-iframework|-isystem|-cxx-isystem|-iquote|-idirafter|-isysroot|-arch)$")
      set(pending "${argument}")
    elseif(argument MATCHES "^(${compile_options})$")
      list(APPEND options "${argument}")
    else()
      reject("${input}" "unsupported compiler argument: ${argument}")
    endif()
  endforeach()
  if(pending)
    reject("${input}" "missing compiler argument for ${pending}")
  endif()
  if(input MATCHES "[.]c$")
    set(language c)
  else()
    set(language c++)
  endif()
  string(SHA256 search_key "${compiler};${language};${directory};${options}")
  get_property(cached GLOBAL PROPERTY "search_${search_key}_quote_paths" SET)
  if(cached)
    get_property(quote_paths GLOBAL PROPERTY "search_${search_key}_quote_paths")
    get_property(angle_paths GLOBAL PROPERTY "search_${search_key}_angle_paths")
    get_property(framework_paths GLOBAL PROPERTY "search_${search_key}_framework_paths")
  else()
    read_compiler_search_paths()
  endif()
  set("${output_quote}" "${quote_paths}" PARENT_SCOPE)
  set("${output_angle}" "${angle_paths}" PARENT_SCOPE)
  set("${output_framework}" "${framework_paths}" PARENT_SCOPE)
endfunction()

macro(read_compiler_search_paths)
  execute_process(COMMAND "${compiler}" -x "${language}" ${options} -E -v - -o /dev/null
    WORKING_DIRECTORY "${directory}" INPUT_FILE /dev/null
    ERROR_VARIABLE trace RESULT_VARIABLE result)
  if(NOT result EQUAL 0 OR NOT trace MATCHES
      "#include \"[.][.][.]\" search starts here:\n([^\r]*)End of search list[.]")
    reject("${input}" "could not read Clang include search paths:\n${trace}")
  endif()
  string(REPLACE "\n" ";" paths "${CMAKE_MATCH_1}")
  set(quote_paths)
  set(angle_paths)
  set(framework_paths)
  set(group quote_paths)
  foreach(path IN LISTS paths)
    string(STRIP "${path}" path)
    if(path STREQUAL "#include <...> search starts here:")
      set(group angle_paths)
    elseif(path MATCHES "^(.+) [(]framework directory[)]$")
      set(path "${CMAKE_MATCH_1}")
      cmake_path(ABSOLUTE_PATH path BASE_DIRECTORY "${directory}" NORMALIZE)
      list(APPEND framework_paths "${path}")
    elseif(NOT path STREQUAL "")
      cmake_path(ABSOLUTE_PATH path BASE_DIRECTORY "${directory}" NORMALIZE)
      list(APPEND "${group}" "${path}")
    endif()
  endforeach()
  foreach(group IN ITEMS quote_paths angle_paths framework_paths)
    set_property(GLOBAL PROPERTY "search_${search_key}_${group}" "${${group}}")
  endforeach()
endmacro()

function(is_googletest_header path output)
  set(inside FALSE)
  if(googletest)
    file(REAL_PATH "${path}" resolved)
    cmake_path(IS_PREFIX googletest "${resolved}" NORMALIZE inside)
  endif()
  set("${output}" "${inside}" PARENT_SCOPE)
endfunction()

function(is_project_header path output)
  set(project FALSE)
  if(EXISTS "${path}")
    file(REAL_PATH "${path}" resolved)
    cmake_path(IS_PREFIX source "${resolved}" NORMALIZE in_source)
    cmake_path(IS_PREFIX build "${resolved}" NORMALIZE in_build)
    is_googletest_header("${resolved}" in_googletest)
    cmake_path(IS_PREFIX source "${path}" NORMALIZE written_in_source)
    cmake_path(IS_PREFIX build "${path}" NORMALIZE written_in_build)
    if(in_googletest)
      if(NOT test_directory)
        set(project TRUE)
      endif()
    elseif(in_source OR in_build OR written_in_source OR written_in_build)
      set(project TRUE)
    endif()
  endif()
  set("${output}" "${project}" PARENT_SCOPE)
endfunction()

function(search_project_header name paths frameworks output)
  foreach(path IN LISTS paths)
    is_project_header("${path}/${name}" found)
    if(found)
      set("${output}" "${path}/${name}" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  if(frameworks AND name MATCHES "^([^/]+)/(.+)$")
    set(framework "${CMAKE_MATCH_1}")
    set(header "${CMAKE_MATCH_2}")
    foreach(path IN LISTS frameworks)
      foreach(folder IN ITEMS Headers PrivateHeaders)
        is_project_header("${path}/${framework}.framework/${folder}/${header}" found)
        if(found)
          set("${output}" "${path}/${framework}.framework/${folder}/${header}" PARENT_SCOPE)
          return()
        endif()
      endforeach()
    endforeach()
  endif()
  set("${output}" FALSE PARENT_SCOPE)
endfunction()

function(resolves_external name paths frameworks output)
  set(candidates)
  foreach(path IN LISTS paths)
    list(APPEND candidates "${path}/${name}")
  endforeach()
  if(frameworks AND name MATCHES "^([^/]+)/(.+)$")
    set(framework "${CMAKE_MATCH_1}")
    set(header "${CMAKE_MATCH_2}")
    foreach(path IN LISTS frameworks)
      list(APPEND candidates "${path}/${framework}.framework/Headers/${header}"
        "${path}/${framework}.framework/PrivateHeaders/${header}")
    endforeach()
  endif()
  foreach(candidate IN LISTS candidates)
    if(EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
      is_project_header("${candidate}" project_header)
      if(NOT project_header)
        set("${output}" TRUE PARENT_SCOPE)
        return()
      endif()
      break()
    endif()
  endforeach()
  set("${output}" FALSE PARENT_SCOPE)
endfunction()

function(check_spelling path owner test_directory name quoted probe)
  cmake_path(GET path PARENT_PATH directory)
  set(in_public FALSE)
  if(owner IN_LIST modules)
    cmake_path(IS_PREFIX "public_root_${owner}" "${path}" NORMALIZE in_public)
  endif()
  if(probe)
    set(probe_paths "${angle_paths}")
    if(quoted)
      list(PREPEND probe_paths "${directory}" ${quote_paths})
    endif()
    search_project_header("${name}" "${probe_paths}" "${framework_paths}" project_header)
    if(project_header OR IS_ABSOLUTE "${name}" OR name MATCHES "(^doqe/|(^|/)[.][.](/|$))")
      reject("${path}" "project header probe '${name}'")
    endif()
    return()
  endif()

  if(name MATCHES "^doqe(/|$)")
    if(NOT quoted OR NOT name MATCHES "^doqe/([a-z]+)/[^/].*$"
        OR name MATCHES "(//|/$|(^|/)[.]([.])?(/|$))")
      reject("${path}" "invalid module-public include '${name}'")
    endif()
    string(REGEX REPLACE "^doqe/([a-z]+)/.*$" "\\1" dependency "${name}")
    string(REGEX REPLACE "^doqe/[a-z]+/" "" header_name "${name}")
    if(owner STREQUAL "support")
      set(allowed "${SUPPORT_LINKS}")
    elseif(test_directory)
      set(allowed "${TEST_LINKS}")
    else()
      set(allowed "${direct_${owner}}")
    endif()
    if(NOT dependency STREQUAL owner AND NOT dependency IN_LIST allowed)
      reject("${path}" "${owner} has no direct dependency on ${dependency}")
    endif()
    if(in_public AND NOT dependency STREQUAL owner AND NOT dependency IN_LIST public_${owner})
      reject("${path}" "${owner} public header needs a PUBLIC edge to ${dependency}")
    endif()
    set(header "${public_root_${dependency}}/${header_name}")
    file(REAL_PATH "${header}" resolved)
    cmake_path(IS_PREFIX "public_root_${dependency}" "${resolved}" NORMALIZE is_public)
    if(NOT IS_DIRECTORY "${public_root_${dependency}}" OR NOT EXISTS "${header}" OR NOT is_public)
      reject("${path}" "include '${name}' must resolve to a public header")
    endif()
    if(EXISTS "${directory}/${name}")
      file(REAL_PATH "${directory}/${name}" shadow)
      if(NOT shadow STREQUAL resolved)
        reject("${path}" "local header shadows '${name}'")
      endif()
    endif()
    return()
  endif()

  if(IS_ABSOLUTE "${name}")
    reject("${path}" "absolute include '${name}'")
  endif()
  if(NOT quoted AND NOT name MATCHES "(^|/)[.][.](/|$)")
    search_project_header("${name}" "${angle_paths}" "${framework_paths}" project_header)
    if(project_header)
      is_googletest_header("${project_header}" in_googletest)
      if(in_googletest)
        reject("${path}" "GoogleTest headers are test-only: '${name}'")
      endif()
      reject("${path}" "project headers require quoted includes: '${name}'")
    endif()
    return()
  endif()

  # Check both lexical traversal and symlinks. An include must stay within
  # its private root at every step, even if it would end up back inside.
  set(private_root "${root_${owner}}")
  if(test_directory)
    set(private_root "${test_directory}")
    set(candidate "${directory}/${name}")
    cmake_path(IS_PREFIX support_root "${candidate}" NORMALIZE in_support)
    if(quoted AND NOT owner STREQUAL "support" AND in_support AND EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
      file(REAL_PATH "${candidate}" resolved)
      cmake_path(IS_PREFIX support_root "${resolved}" NORMALIZE in_support)
      if(in_support)
        return()
      endif()
    endif()
  elseif(path STREQUAL generated)
    set(private_root "${directory}")
  endif()
  set(candidates "${directory}/${name}" "${private_root}/${name}")
  if(test_directory AND owner IN_LIST modules)
    list(APPEND candidates "${root_${owner}}/${name}")
  endif()
  foreach(candidate IN LISTS candidates)
    set(candidate_root "${private_root}")
    if(test_directory AND owner IN_LIST modules)
      cmake_path(IS_PREFIX "root_${owner}" "${candidate}" in_own_module)
      if(in_own_module)
        set(candidate_root "${root_${owner}}")
      endif()
    endif()
    string(LENGTH "${candidate_root}/" root_length)
    string(SUBSTRING "${candidate}" "${root_length}" -1 relative)
    string(REPLACE "/" ";" components "${relative}")
    set(depth 0)
    foreach(component IN LISTS components)
      if(component STREQUAL "..")
        math(EXPR depth "${depth} - 1")
      elseif(NOT component STREQUAL "." AND NOT component STREQUAL "")
        math(EXPR depth "${depth} + 1")
      endif()
      if(depth LESS 0)
        break()
      endif()
    endforeach()
    if(EXISTS "${candidate}")
      file(REAL_PATH "${candidate}" resolved)
    else()
      set(resolved "${candidate}")
      cmake_path(NORMAL_PATH resolved)
    endif()
    cmake_path(IS_PREFIX candidate_root "${resolved}" NORMALIZE inside)
    if(depth LESS 0 OR NOT inside)
      if(test_directory)
        reject("${path}" "include leaves test directory ${owner}: '${name}'")
      endif()
      reject("${path}" "include leaves module ${owner}: '${name}'")
    endif()
    if(quoted AND EXISTS "${resolved}" AND NOT IS_DIRECTORY "${resolved}")
      if(in_public)
        cmake_path(IS_PREFIX "public_root_${owner}" "${resolved}" NORMALIZE is_public)
        if(NOT is_public)
          reject("${path}" "public header includes private header '${name}'")
        endif()
      endif()
      return()
    endif()
  endforeach()
  if(owner STREQUAL "cli" AND name STREQUAL "build_version.hpp" AND quoted AND NOT in_public)
    return()
  endif()
  if(quoted)
    resolves_external("${name}" "${quote_paths};${angle_paths}" "${framework_paths}" external)
    if(external)
      return()
    endif()
  endif()
  reject("${path}" "include '${name}' must resolve inside module ${owner}")
endfunction()

# The minimizer skips digraph hashes. Normalize just those tokens reported
# by Clang's raw lexer before minimizing, leaving literals and comments intact.
function(minimize_directives path output)
  set(input "${path}")
  file(READ "${path}" contents)
  if(contents MATCHES "%(:|\\\\[ \t]*\r?\n)")
    execute_process(COMMAND "${CLANG}" -cc1 -x c++ -std=c++23 -dump-raw-tokens "${path}"
      ERROR_VARIABLE tokens COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "hash +'%:' +Loc=<[^\r\n]+:[0-9]+:[0-9]+>" hashes "${tokens}")
    set(offset 0)
    set(line_number 1)
    foreach(hash IN LISTS hashes)
      if(NOT hash MATCHES ":([0-9]+):([0-9]+)>$")
        reject("${path}" "could not locate digraph hash")
      endif()
      set(token_line "${CMAKE_MATCH_1}")
      set(column "${CMAKE_MATCH_2}")
      while(line_number LESS token_line)
        string(SUBSTRING "${contents}" "${offset}" -1 tail)
        string(FIND "${tail}" "\n" end)
        math(EXPR offset "${offset} + ${end} + 1")
        math(EXPR line_number "${line_number} + 1")
      endwhile()
      math(EXPR start "${offset} + ${column} - 1")
      string(SUBSTRING "${contents}" 0 "${start}" prefix)
      string(SUBSTRING "${contents}" "${start}" -1 tail)
      if(NOT tail MATCHES "^%(\\\\[ \t]*\r?\n)*:")
        reject("${path}" "could not normalize digraph hash")
      endif()
      string(LENGTH "${CMAKE_MATCH_0}" length)
      string(REGEX REPLACE "^%(.*):$" "#\\1 " replacement "${CMAKE_MATCH_0}")
      string(SUBSTRING "${tail}" "${length}" -1 tail)
      set(contents "${prefix}${replacement}${tail}")
    endforeach()
    if(hashes)
      set(input "${build}/CMakeFiles/module-boundary-directives.cpp")
      file(WRITE "${input}" "${contents}")
    endif()
  endif()
  execute_process(COMMAND "${CLANG}" -cc1 -x c++ -std=c++23
    -print-dependency-directives-minimized-source "${input}"
    OUTPUT_VARIABLE directives COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX REPLACE "\\\\[ \t]*\r?\n" "" directives "${directives}")
  set("${output}" "${directives}" PARENT_SCOPE)
endfunction()

function(check_resource_directive path owner test_directory directive body probes)
  set(header_literal [=[("([^"]+)"|<([^>]+)>)]=])
  if(directive STREQUAL "embed")
    if(NOT body MATCHES "^[ \t]*${header_literal}")
      reject("${path}" "use a literal resource name in #embed")
    endif()
    if(CMAKE_MATCH_2)
      check_spelling("${path}" "${owner}" "${test_directory}" "${CMAKE_MATCH_2}" TRUE FALSE)
    else()
      check_spelling("${path}" "${owner}" "${test_directory}" "${CMAKE_MATCH_3}" FALSE FALSE)
    endif()
  endif()
  foreach(offset IN LISTS probes)
    string(SUBSTRING "${body}" "${offset}" -1 probe)
    if(NOT probe MATCHES "^${probe_builtin}[ \t]*[(][ \t]*${header_literal}")
      reject("${path}" "use a literal header or resource name in ${probe}")
    endif()
    set(builtin "${CMAKE_MATCH_1}")
    set(quoted_name "${CMAKE_MATCH_3}")
    set(angle_name "${CMAKE_MATCH_4}")
    string(LENGTH "${CMAKE_MATCH_0}" length)
    string(SUBSTRING "${probe}" "${length}" -1 suffix)
    if(NOT builtin STREQUAL "__has_embed" AND NOT suffix MATCHES "^[ \t]*[)]")
      reject("${path}" "use a literal header name in ${builtin}")
    endif()
    if(quoted_name)
      check_spelling("${path}" "${owner}" "${test_directory}" "${quoted_name}" TRUE TRUE)
    else()
      check_spelling("${path}" "${owner}" "${test_directory}" "${angle_name}" FALSE TRUE)
    endif()
  endforeach()
endfunction()

# The dependency minimizer drops #embed. Use raw preprocessing tokens for
# resource directives and builtin probes so text in literals never acts as an identifier.
function(scan_resource_directives path owner test_directory)
  set(probe_builtin "(__has_include_next|__has_include|__has_embed)")
  file(READ "${path}" contents)
  string(REGEX REPLACE "\\\\[ \t]*\r?\n" "" contents "${contents}")
  if(NOT contents MATCHES "embed|__has_include")
    return()
  endif()
  execute_process(COMMAND "${CLANG}" -cc1 -x c++ -std=c++23 -dump-raw-tokens "${path}"
    ERROR_VARIABLE dump COMMAND_ERROR_IS_FATAL ANY)
  # Escape CMake list syntax before extracting one record per token.
  foreach(character IN ITEMS "%" ";" "[" "]")
    string(HEX "${character}" code)
    string(REPLACE "${character}" "%${code}" dump "${dump}")
  endforeach()
  set(record "([a-z_][a-z_0-9]*)[ \t]+'([^\n]*)'[ \t]+Loc=<[^\n]+:[0-9]+:[0-9]+>")
  string(REGEX MATCHALL "(^|\n)${record}" records "${dump}")
  set(line_start TRUE)
  set(directive "")
  set(body "")
  set(probes)
  foreach(token IN LISTS records)
    if(NOT token MATCHES "${record}$")
      reject("${path}" "could not read Clang preprocessing token")
    endif()
    set(kind "${CMAKE_MATCH_1}")
    set(spelling "${CMAKE_MATCH_2}")
    if(kind STREQUAL "unknown" AND spelling MATCHES "\\\\n|\\\\r")
      check_resource_directive("${path}" "${owner}" "${test_directory}" "${directive}" "${body}" "${probes}")
      set(line_start TRUE)
      set(directive "")
      set(body "")
      set(probes)
    elseif(kind STREQUAL "unknown" OR kind STREQUAL "comment")
      string(APPEND body " ")
    elseif(line_start AND kind STREQUAL "hash")
      set(line_start FALSE)
      set(directive "#")
    elseif(directive STREQUAL "#")
      set(directive "${spelling}")
      set(body "")
    else()
      set(line_start FALSE)
      if(NOT directive MATCHES "^(define|if|elif|embed)$")
        continue()
      endif()
      if(kind STREQUAL "raw_identifier" AND spelling MATCHES "^${probe_builtin}$")
        if(directive STREQUAL "define")
          reject("${path}" "macro aliases ${spelling}")
        endif()
        if(NOT body MATCHES "(^|[^a-zA-Z_0-9])defined([ \t]+|[ \t]*[(][ \t]*)$")
          string(LENGTH "${body}" offset)
          list(APPEND probes "${offset}")
        endif()
      endif()
      string(REPLACE "%3b" ";" spelling "${spelling}")
      string(REPLACE "%5b" "[" spelling "${spelling}")
      string(REPLACE "%5d" "]" spelling "${spelling}")
      string(REPLACE "%25" "%" spelling "${spelling}")
      string(REPLACE [=[\"]=] [=["]=] spelling "${spelling}")
      string(APPEND body "${spelling}")
    endif()
  endforeach()
  check_resource_directive("${path}" "${owner}" "${test_directory}" "${directive}" "${body}" "${probes}")
endfunction()

# Clang retains include directives with comments and literals already tokenized.
function(scan path owner test_directory quote_paths angle_paths framework_paths)
  scan_resource_directives("${path}" "${owner}" "${test_directory}")
  minimize_directives("${path}" directives)
  set(header_literal [=[("([^"]+)"|<([^>]+)>)]=])
  while(NOT directives STREQUAL "")
    string(FIND "${directives}" "\n" end)
    if(end LESS 0)
      set(line "${directives}")
      set(directives "")
    else()
      string(SUBSTRING "${directives}" 0 "${end}" line)
      math(EXPR next "${end} + 1")
      string(SUBSTRING "${directives}" "${next}" -1 directives)
    endif()
    if(line MATCHES "^#[ \t]*(include|include_next|import)([^a-zA-Z_0-9]|$)")
      if(NOT line MATCHES "^#[ \t]*include[ \t]*${header_literal}[ \t]*$")
        reject("${path}" "use a literal #include")
      endif()
      if(CMAKE_MATCH_2)
        check_spelling("${path}" "${owner}" "${test_directory}" "${CMAKE_MATCH_2}" TRUE FALSE)
      else()
        check_spelling("${path}" "${owner}" "${test_directory}" "${CMAKE_MATCH_3}" FALSE FALSE)
      endif()
    endif()
  endwhile()
endfunction()

ninja_tool(deps deps)
string(REPLACE "\n" ";" deps "${deps}")
unset(output_key)
foreach(line IN LISTS deps)
  if(line MATCHES "^(.+): #deps [0-9]+, deps mtime .+ [(]VALID[)]$")
    string(SHA256 output_key "${CMAKE_MATCH_1}")
    set(deps_${output_key} "")
  elseif(DEFINED output_key AND line MATCHES "^    (.+)$")
    list(APPEND deps_${output_key} "${CMAKE_MATCH_1}")
  else()
    unset(output_key)
  endif()
endforeach()

set(compiles 0)
foreach(index RANGE 0 "${last}")
  string(JSON output GET "${compdb}" "${index}" output)
  if(NOT output MATCHES "(^|/)CMakeFiles/(doqe(_[a-z]+|_test_support|_base_test|_status_tests)?)[.]dir/.+[.]o$")
    continue()
  endif()
  set(target "${CMAKE_MATCH_2}")
  if(target MATCHES "^(doqe|doqe_tests|doqe_status_tests)$")
    list(APPEND objects_${target} "${build}/${output}")
  endif()
  string(JSON input GET "${compdb}" "${index}" file)
  string(JSON directory GET "${compdb}" "${index}" directory)
  file(REAL_PATH "${input}" path BASE_DIRECTORY "${directory}")

  set(test_directory "")
  if(target MATCHES "^(doqe_tests|doqe_test_support|doqe_status_tests)$")
    file(RELATIVE_PATH relative "${source}/tests" "${path}")
    if(NOT relative MATCHES "^([a-z]+)/")
      reject("${path}" "test source outside a test directory")
    endif()
    set(owner "${CMAKE_MATCH_1}")
    if(NOT owner MATCHES "^(integration|support)$" AND NOT owner IN_LIST modules)
      reject("${path}" "unknown test directory '${owner}'")
    endif()
    set(test_directory "${source}/tests/${owner}")
    set(allowed "${test_closure}")
    if(target STREQUAL "doqe_test_support")
      set(allowed "${support_closure}")
    elseif(target STREQUAL "doqe_status_tests")
      set(allowed base)
    endif()
  else()
    string(REGEX REPLACE "^doqe(_|$)" "" owner "${target}")
    if(target STREQUAL "doqe_base_test")
      set(owner base)
    elseif(owner STREQUAL "")
      set(owner cli)
    elseif(NOT owner IN_LIST modules)
      continue()
    endif()
    cmake_path(IS_PREFIX "root_${owner}" "${path}" NORMALIZE inside)
    if(NOT inside)
      reject("${path}" "${target}: source outside module ${owner}")
    endif()
    set(allowed "${include_closure_${owner}}")
  endif()

  string(SHA256 output_key "${output}")
  if(NOT DEFINED deps_${output_key})
    reject("${output}" "missing or stale compiler dependencies")
  endif()
  math(EXPR compiles "${compiles} + 1")
  string(JSON command GET "${compdb}" "${index}" command)
  compiler_search_paths("${command}" "${directory}" "${input}" quotes angles frameworks)
  list(APPEND quotes_${owner} ${quotes})
  list(APPEND angles_${owner} ${angles})
  list(APPEND frameworks_${owner} ${frameworks})
  list(APPEND scanned_paths "${path}")
  string(SHA256 key "${path}")
  list(APPEND quotes_file_${key} ${quotes})
  list(APPEND angles_file_${key} ${angles})
  list(APPEND frameworks_file_${key} ${frameworks})
  foreach(item IN LISTS deps_${output_key})
    cmake_path(ABSOLUTE_PATH item BASE_DIRECTORY "${build}" OUTPUT_VARIABLE absolute_item)
    is_project_header("${absolute_item}" project_header)
    if(NOT project_header)
      continue()
    endif()
    file(REAL_PATH "${item}" dependency BASE_DIRECTORY "${build}")
    if(dependency STREQUAL path OR dependency STREQUAL toolchain_header)
      continue()
    endif()
    set(violation "")
    is_googletest_header("${dependency}" in_googletest)
    cmake_path(IS_PREFIX support_root "${dependency}" NORMALIZE in_support)
    if(in_googletest)
      set(violation "compiler dependency on test-only GoogleTest header: ${dependency}")
    elseif(NOT (dependency STREQUAL generated AND owner STREQUAL "cli") AND NOT (test_directory AND in_support))
      cmake_path(IS_PREFIX test_directory "${dependency}" NORMALIZE in_tests)
      if(NOT test_directory OR NOT in_tests)
        file(RELATIVE_PATH relative "${source}/src" "${dependency}")
        set(dependency_owner "")
        if(relative MATCHES "^([a-z]+)/")
          set(dependency_owner "${CMAKE_MATCH_1}")
        endif()
        if(NOT dependency_owner IN_LIST modules OR
            (NOT dependency_owner STREQUAL owner AND NOT dependency_owner IN_LIST allowed))
          set(violation "compiler dependency outside the allowed closure: ${dependency}")
        elseif(NOT dependency_owner STREQUAL owner)
          cmake_path(IS_PREFIX "public_root_${dependency_owner}" "${dependency}" NORMALIZE in_public)
          if(NOT in_public)
            set(violation "compiler dependency on foreign private header: ${dependency}")
          endif()
        endif()
      endif()
    endif()
    if(violation)
      # Prefer the declaring directive's diagnostic when there is one.
      if(NOT dependency_violation)
        set(dependency_violation "${violation}")
        set(violation_input "${path}")
      endif()
      continue()
    endif()
    string(SHA256 key "${dependency}")
    list(APPEND quotes_file_${key} ${quotes})
    list(APPEND angles_file_${key} ${angles})
    list(APPEND frameworks_file_${key} ${frameworks})
    list(APPEND scanned_paths "${dependency}")
  endforeach()
endforeach()

if(compiles EQUAL 0)
  message(FATAL_ERROR "Module include boundaries: no module compiler dependencies found")
endif()
check_final_link(doqe)
if(BUILD_TESTING)
  check_final_link(doqe_tests)
  check_final_link(doqe_status_tests)
endif()
set(scan_roots)
foreach(owner IN LISTS modules)
  list(APPEND scan_roots "${root_${owner}}")
  if(BUILD_TESTING)
    list(APPEND scan_roots "${source}/tests/${owner}")
  endif()
endforeach()
if(BUILD_TESTING)
  list(APPEND scan_roots "${source}/tests/integration" "${support_root}")
endif()
foreach(root IN LISTS scan_roots)
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE "${root}/*")
  list(FILTER files EXCLUDE REGEX "(^|/)(CMakeLists[.]txt|[.]gitkeep)$|[.]in$")
  # These exact files accompany the vendored Arrow C header.
  list(REMOVE_ITEM files
    "${source}/src/column/include/doqe/column/arrow/LICENSE.txt"
    "${source}/src/column/include/doqe/column/arrow/NOTICE.txt")
  list(APPEND scanned_paths ${files})
endforeach()
list(APPEND scanned_paths "${generated}")
list(REMOVE_DUPLICATES scanned_paths)
foreach(path IN LISTS scanned_paths)
  set(test_directory "")
  if(path STREQUAL generated)
    set(owner cli)
  else()
    file(RELATIVE_PATH relative "${source}" "${path}")
    if(NOT relative MATCHES "^(src|tests)/([a-z]+)/")
      reject("${path}" "cannot determine header owner")
    endif()
    set(owner "${CMAKE_MATCH_2}")
    if(CMAKE_MATCH_1 STREQUAL "tests")
      set(test_directory "${source}/tests/${owner}")
    endif()
  endif()
  string(SHA256 key "${path}")
  foreach(group IN ITEMS quotes angles frameworks)
    set("${group}" "${${group}_file_${key}}")
    if(NOT DEFINED angles_file_${key})
      set("${group}" "${${group}_${owner}}")
    endif()
    list(REMOVE_ITEM "${group}" "")
    list(REMOVE_DUPLICATES "${group}")
  endforeach()
  scan("${path}" "${owner}" "${test_directory}" "${quotes}" "${angles}" "${frameworks}")
endforeach()
if(dependency_violation)
  reject("${violation_input}" "${dependency_violation}")
endif()
list(LENGTH modules module_count)
message(STATUS "Module include boundaries passed (${module_count} modules)")
