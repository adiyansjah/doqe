cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/modules.cmake")
set(adr "${CMAKE_CURRENT_LIST_DIR}/../docs/adrs/0002-architecture-modules/adr.md")
file(STRINGS "${adr}" rows ENCODING UTF-8 REGEX "^[|] [0-9]+ · [^|]+[|]")
set(expected_rows)
foreach(row IN LISTS rows)
  if(NOT row MATCHES "^[|][^|]+[|] +`([a-z]+)`([^|]*)[|]([^|]*)[|]$")
    message(FATAL_ERROR "Invalid module edge row in ADR-0002: ${row}")
  endif()
  set(owner "${CMAKE_MATCH_1}")
  set(annotation "${CMAKE_MATCH_2}")
  set(edges "${CMAKE_MATCH_3}")
  if(annotation MATCHES "[(]deferred[)]")
    continue()
  endif()
  # Prose after the edge list starts after a backtick, a full stop and a space.
  string(REGEX REPLACE "`[.] .*$" "`." edges "${edges}")
  string(STRIP "${edges}" edges)
  if(NOT edges STREQUAL "—" AND NOT edges MATCHES "^`[a-z]+`( *, *`[a-z]+`)*[.]?$")
    message(FATAL_ERROR "Invalid dependency cell in ADR-0002 for ${owner}: ${edges}")
  endif()
  string(REGEX MATCHALL "`[a-z]+`" modules "${edges}")
  string(REPLACE "`" "" modules "${modules}")
  list(SORT modules)
  list(JOIN modules "|" edges)
  string(REGEX REPLACE "[|]$" "" expected "${owner}|${edges}")
  list(APPEND expected_rows "${expected}")
endforeach()
set(actual_rows)
foreach(row IN LISTS doqe_module_edges)
  string(REPLACE "+" "" row "${row}")
  string(REPLACE "|" ";" fields "${row}")
  list(POP_FRONT fields owner)
  list(SORT fields)
  list(JOIN fields "|" edges)
  string(REGEX REPLACE "[|]$" "" actual "${owner}|${edges}")
  list(APPEND actual_rows "${actual}")
endforeach()
list(SORT expected_rows)
list(SORT actual_rows)
if(NOT actual_rows STREQUAL expected_rows)
  message(FATAL_ERROR "Module edge table differs from ADR-0002\nCMake: ${actual_rows}\nADR: ${expected_rows}")
endif()
message(STATUS "Module edge table matches ADR-0002")
